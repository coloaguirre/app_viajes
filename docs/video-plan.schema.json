{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitacoraviaje.app/schemas/video-plan.schema.json",
  "title": "Bitácora de Viaje — video_plan.json",
  "description": "Plan declarativo del video (DISENO §13.3), independiente del motor. Las referencias media/segments/place/voice son ids de trip.json. schema_version 1.",
  "type": "object",
  "required": [
    "schema_version",
    "output",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "output": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string"
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duck_under_voice": {
          "type": "boolean"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "total_duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "ms": {
      "type": "integer",
      "minimum": 0
    },
    "kenburns": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "to": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "title"
            },
            "duration_ms": {
              "$ref": "#/$defs/ms"
            },
            "title": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            },
            "background_media": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "duration_ms",
            "title"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "map_route"
            },
            "duration_ms": {
              "$ref": "#/$defs/ms"
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": {
              "enum": [
                "overview",
                "follow"
              ]
            }
          },
          "required": [
            "type",
            "duration_ms",
            "segments",
            "style"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "chapter"
            },
            "duration_ms": {
              "$ref": "#/$defs/ms"
            },
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "segment": {
              "type": "string"
            },
            "weather": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "duration_ms",
            "title",
            "segment"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "photo"
            },
            "duration_ms": {
              "$ref": "#/$defs/ms"
            },
            "media": {
              "type": "string"
            },
            "kenburns": {
              "$ref": "#/$defs/kenburns"
            },
            "caption": {
              "type": "string"
            },
            "subtitle_from_voice": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "duration_ms",
            "media",
            "kenburns"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "video_clip"
            },
            "media": {
              "type": "string"
            },
            "trim_start_ms": {
              "$ref": "#/$defs/ms"
            },
            "trim_end_ms": {
              "$ref": "#/$defs/ms"
            },
            "keep_audio": {
              "type": "boolean"
            },
            "caption": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "media",
            "trim_start_ms",
            "trim_end_ms"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "voice_overlay"
            },
            "duration_ms": {
              "$ref": "#/$defs/ms"
            },
            "voice": {
              "type": "string"
            },
            "segment": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "duration_ms",
            "voice",
            "segment"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "place_card"
            },
            "duration_ms": {
              "$ref": "#/$defs/ms"
            },
            "place": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "duration_ms",
            "place",
            "title",
            "text",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "stats"
            },
            "duration_ms": {
              "$ref": "#/$defs/ms"
            },
            "segment": {
              "type": "string"
            },
            "distance_m": {
              "type": "number"
            },
            "moving_time_ms": {
              "type": "integer"
            },
            "elevation_gain_m": {
              "type": "number"
            },
            "max_alt_m": {
              "type": "number"
            },
            "photos": {
              "type": "integer"
            },
            "days": {
              "type": "integer"
            },
            "places": {
              "type": "integer"
            }
          },
          "required": [
            "type",
            "duration_ms"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "credits"
            },
            "duration_ms": {
              "$ref": "#/$defs/ms"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "duration_ms",
            "lines"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
