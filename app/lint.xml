<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- targetSdk 36 is a deliberate decision (PLAN.md §3): Play requires 36 for 2026;
         compileSdk is 37 because current AndroidX needs it. Revisit at Phase 6. -->
    <issue id="OldTargetApi" severity="ignore" />
    <!-- Kotlin is pinned to the version Hilt validates against (gradle/libs.versions.toml). -->
    <issue id="NewerVersionAvailable">
        <ignore regexp="org\.jetbrains\.kotlin" />
    </issue>
    <!-- Adaptive icons must live in mipmap-anydpi-v26: AAPT2 rejects them in an unqualified folder
         even with minSdk 26. -->
    <issue id="ObsoleteSdkInt" severity="ignore">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!-- MapLibre pulls Timber transitively; this app logs through android.util.Log with the
         'Bitacora' tag by convention (CLAUDE.md). -->
    <issue id="LogNotTimber" severity="ignore" />
    <!-- Visible texts are Spanish; lint's typo dictionary is English ("Momento" -> "Memento"). -->
    <issue id="Typos">
        <ignore path="src/main/res/values/strings.xml" />
    </issue>
</lint>
