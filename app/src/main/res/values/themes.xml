<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only avoids a white flash before the first frame. -->
    <style name="Theme.Bitacora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <style name="Theme.Bitacora.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
